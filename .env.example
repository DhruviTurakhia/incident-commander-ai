APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=data/incident_commander.db

# Optional: enable the one-time AI planner.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: run the Slack Socket Mode adapter.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: run workflows through Temporal.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=incident-commander

# Read-only integrations should use least-privilege credentials.
GITHUB_TOKEN=
PROMETHEUS_URL=
LOKI_URL=
KUBECONFIG=

